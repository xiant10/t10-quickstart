# Any OpenAI-compatible endpoint. Replace the key, and the model names if your provider differs.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-provider-key

# Provider model names, used by compose.all.yml (through the ai-gateway aliases "fast" and "smart").
FAST_MODEL_NAME=gpt-4o-mini
SMART_MODEL_NAME=gpt-4o

# Used by compose.yml: the model names agent-pi sends to your provider. They default to
# gpt-4o-mini and gpt-4o. Set them only for another provider. compose.all.yml ignores them
# and uses the aliases "fast" and "smart".
# FAST_MODEL_ID=gpt-4o-mini
# SMART_MODEL_ID=gpt-4o

# Live calls (compose.all.yml only): speech-to-text and text-to-speech use OpenAI with the
# LLM_API_KEY above. Set this only if the speech key differs from it.
# OPENAI_SPEECH_API_KEY=your-openai-key
