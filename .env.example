# Any OpenAI-compatible endpoint. Replace the key, and the model names if your provider differs.
# For OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1, its key, and model names such as
# openai/gpt-4o-mini (README, "Choose a model").
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-provider-key

# Provider model names, used by compose.all.yml (through the ai-gateway aliases "fast" and "smart").
# They default to gpt-4o-mini and gpt-4o.
FAST_MODEL_NAME=gpt-4o-mini
SMART_MODEL_NAME=gpt-4o

# Used by compose.yml: the model names agent-pi sends to your provider. They default to
# gpt-4o-mini and gpt-4o. Set them only for another provider. compose.all.yml ignores them
# and uses the aliases "fast" and "smart".
# FAST_MODEL_ID=gpt-4o-mini
# SMART_MODEL_ID=gpt-4o

# Voice (compose.all.yml only). README, "Voice", has the choices.
#
# Voice messages: speech to text goes through ai-gateway to DashScope, with this key.
# DASHSCOPE_API_KEY=your-dashscope-key
#
# Live calls: speech to text and text to speech use OpenAI by default, with LLM_API_KEY unless
# OPENAI_SPEECH_API_KEY is set. Set both providers to qwen to use DASHSCOPE_API_KEY instead.
# STT_PROVIDER=openai
# TTS_PROVIDER=openai
# OPENAI_SPEECH_API_KEY=your-openai-key
#
# Live calls through OpenRouter (it has batch speech only, so no live captions):
# STT_PROVIDER=openai
# TTS_PROVIDER=openai
# OPENAI_SPEECH_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_STT_MODEL=openai/whisper-1
# OPENAI_TTS_MODEL=hexgrad/kokoro-82m
# QWEN_TTS_VOICE=af_alloy
# TTS_TIMEOUT_MS=20000
#
# QWEN_TTS_VOICE is the live-call voice for whichever TTS is on: alloy for OpenAI, Cherry for
# qwen, af_alloy for Kokoro. TTS_TIMEOUT_MS (8000 by default) is how long one sentence may take.

# The languages people can choose, comma separated, the default first: zh-Hans gives everyone
# Simplified Chinese and no choice. Unset offers every language. Each person chooses theirs
# on the account page.
# T10_LANGUAGES=zh-Hans
